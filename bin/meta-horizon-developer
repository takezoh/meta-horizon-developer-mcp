#!/usr/bin/env bash
set -euo pipefail

# CLI for the collection owner (auth / collect / capture-csv). Resolve the package path in
# the same way as the MCP entry point by following the `~/.local/bin` symlink.
SOURCE="$0"
while [ -L "$SOURCE" ]; do
	DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PACKAGE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec uv run --project "$PACKAGE_DIR" python -m meta_horizon_developer.cli "$@"
