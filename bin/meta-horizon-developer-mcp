#!/usr/bin/env bash
set -euo pipefail

# Resolve the package path by following the symlink from `~/.local/bin`.
# Callers (such as mcp-gateway) only need to know
# `${HOME}/.local/bin/meta-horizon-developer-mcp`; moving the package to another
# repository does not require configuration changes beyond relinking this path.
SOURCE="$0"
while [ -L "$SOURCE" ]; do
	DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PACKAGE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec uv run --project "$PACKAGE_DIR" python -m meta_horizon_developer.mcp_server "$@"
