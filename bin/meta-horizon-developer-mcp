#!/usr/bin/env bash
set -euo pipefail

# Resolve the package path by following the entry-point symlink.
SOURCE="$0"
while [ -L "$SOURCE" ]; do
	DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PACKAGE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec uv run --project "$PACKAGE_DIR" python -m meta_horizon_developer.mcp_server "$@"
